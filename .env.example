# Copy this file to .env and fill in the values.
# The defaults below are enough to boot locally. The FTP, Fapshi and IPTV
# placeholders must be non-empty for the server to start, but nothing
# connects to those services until a feature that uses them is called.

# ── Server ──────────────────────────────────────────────
# Must be "development" or "production"
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DEV_BASE_URL=http://localhost:3000
PROD_BASE_URL=
# Comma-separated IPs allowed to call the API and open sockets (defaults to 127.0.0.1)
ALLOWED_IPS=127.0.0.1,::1

# ── Database ────────────────────────────────────────────
LOCAL_DB=mongodb://127.0.0.1:27017/atlantic-pearl
REMOTE_DB=

# ── Auth ────────────────────────────────────────────────
JWT_SECRETE=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Minutes an account stays locked after too many failed logins
ACCOUNT_LOGIN_WAIT_TIME=15

# Created automatically on first start when all three are set
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Google OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_DEV=
GOOGLE_REDIRECT_URI_PROD=

# ── Front-end URLs (used in emails and redirects) ──────
FRONT_END_URL=http://localhost:5173
FRONT_END_URL_DEV=http://localhost:5173
FRONT_END_URL_PROD=
FRONT_END_DASHBOARD_REDIRECT=

# ── Email ───────────────────────────────────────────────
# Development sends through Mailtrap, production through EMAIL_SERVICE
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
EMAIL_SERVICE=
EMAIL_AUTH_USER=
EMAIL_AUTH_PASSWORD=

# ── File storage ────────────────────────────────────────
# Development stores uploads on local disk; production uses FTP.
# The FTP values must still be set (placeholders are fine) for the server to start.
DEV_UPLOAD_DIR=
TEMP_DIR=
FTP_HOST=localhost
FTP_PORT=21
FTP_USER=dev
FTP_PASSWORD=dev
FTP_UPLOAD_DIR=/uploads
FTP_BASE_URL=http://localhost:3000/uploads

# ── Payments (Fapshi) ───────────────────────────────────
FAPSHI_SANDBOX_BASE_URL=https://sandbox.fapshi.com
FAPSHI_USER_DEV=replace-me
FAPSHI_API_KEY_DEV=replace-me

# ── IPTV integration ────────────────────────────────────
# Set to "true" to enable IPTV calls on reservation changes
IPTV=false
IPTV_BASE_URL_DEV=http://localhost:9000
IPTV_BASE_URL_PROD=
IPTV_AUTH_TOKEN_DEV=replace-me
IPTV_AUTH_TOKEN_PROD=
# bcrypt hash of the token the IPTV server sends to this API
IPTV_SERVER_SIDE_AUTH_TOKEN_HARSH=
